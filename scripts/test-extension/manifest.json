{
  "manifest_version": 3,
  "name": "Bosk Test Extension",
  "version": "1.0",
  "description": "Checks content scripts, the background worker, the badge and the popup in Bosk.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }],
  "action": { "default_popup": "popup.html", "default_title": "Bosk Test" }
}
